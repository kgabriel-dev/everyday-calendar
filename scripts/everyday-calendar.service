[Unit]
Description=Everyday Calendar frontend/backend autostart
After=network-online.target getty@tty2.service
Wants=network-online.target
Conflicts=getty@tty2.service

[Service]
User=@USER@
Group=@USER@
SupplementaryGroups=tty
WorkingDirectory=/home/@USER@/everyday-calendar
Environment=HOME=/home/@USER@
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/@USER@/.Xauthority
TTYPath=/dev/tty2
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/home/@USER@/everyday-calendar/scripts/start-by-user.sh
Restart=on-failure

[Install]
WantedBy=default.target
